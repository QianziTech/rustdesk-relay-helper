[Unit]
Description=Reconcile RustDesk OSS relay selection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/rustdesk-relay-helper
StateDirectory=rustdesk-relay-helper
StateDirectoryMode=0750
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m relay_helper reconcile
SyslogIdentifier=rustdesk-relay-helper
